{{!
    @template theme_boost/courseindexdrawerheading

    This template will render the heading for the course index drawer.
    The id="courseindexdrawerheading" is referenced by the course index drawer's aria-labelledby attribute.

    Example context (json):
    {
        "coursefullname": "Full name of the course",
        "courseurl": "http://example.com/course/view.php?id=2"
    }
}}
<h2 id="courseindexdrawerheading" class="mb-0">
    <a class="aabtn courseindex-link text-truncate fw-bold" href="{{courseurl}}">
        {{coursefullname}}
    </a>
</h2>
